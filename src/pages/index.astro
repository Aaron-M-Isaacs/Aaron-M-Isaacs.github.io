---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import { site, contactLinks } from "../data/site";

const entries = (
  await getCollection("caseStudies", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Aaron Isaacs — Backend & Cloud Engineer"
  description="Lead Backend Software Engineer working in Python, AWS, and distributed systems, with a working interest in Go and concurrency. Open to remote backend, cloud, and DevOps roles — hybrid or fully remote.."
>
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">{site.role}</p>
      <h1>{site.name}</h1>
      <p class="lede">
        I build backend services and cloud infrastructure, mostly Python and
        AWS, but building my skills in Go and Typescript. I specialize in
        concurrency programming and architecting solutions in cloud
        environments.
      </p>
      <p class="availability">
        Open to Software Engineer, Backend, and Cloud/DevOps roles — hybrid or
        fully remote.
      </p>
      <ul class="actions">
        {
          contactLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <hr />

    <section aria-labelledby="work">
      <h2 id="work">Selected work</h2>
      <p class="section-lede">
        Pieces of my work that I am particularly proud of.
      </p>
      <ul class="grid">
        {
          entries.map((entry) => (
            <li>
              <CaseStudyCard entry={entry} />
            </li>
          ))
        }
      </ul>
    </section>

    <hr />

    <section aria-labelledby="approach" class="approach">
      <h2 id="approach">How I work</h2>
      <p>
        I prefer to follow requirements driven development, a slightly altered
        form of test driven development. I excel at communication, which makes
        translating requirements into tests easy, and then tests into production
        ready code much smoother.
      </p>
      <p>
        "Slow is smooth, smooth is fast" is probably one of my favorite quotes.
        That and "practice doesn't make perfect, perfect practice makes
        perfect." These are principles that I apply to my work, and my everyday
        life.
      </p>
      <p>
        <a href="/about/">More on how I think about this &rarr;</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
    max-width: var(--measure);
  }

  .hero h1 {
    margin-block-start: var(--space-xs);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--text-muted);
    margin-block-start: var(--space-m);
  }

  .availability {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    margin-block-start: var(--space-m);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-l);
  }

  .actions a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: var(--space-xs) var(--space-m);
    text-decoration: none;
    display: inline-block;
  }

  .actions a:hover {
    border-color: var(--accent);
  }

  .section-lede {
    color: var(--text-muted);
    max-width: var(--measure);
    margin-block: var(--space-s) var(--space-l);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-m);
    list-style: none;
    padding: 0;
  }

  .approach {
    max-width: var(--measure);
  }

  .approach p {
    margin-block-start: var(--space-m);
  }
</style>
