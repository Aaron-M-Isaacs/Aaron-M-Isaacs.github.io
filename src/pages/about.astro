---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactLinks } from "../data/site";

const principles = [
  {
    title: "Start from the problem",
    body: "Forget about what the user is asking for, get to the root of what problem they're trying to solve. Often times there's a cleaner solution that makes both the developer and the user happy.",
  },
  {
    title: "Slow is smooth, smooth is fast",
    body: "High quality code and building fast are no longer mutually exclusive with the help of AI. But that doesn't mean we should develop at breakneck speeds either. By using AI, and slowing down just a little, we can achieve high quality code, at still a fraction of the time.",
  },
  {
    title: "Security is a practice, not a phase",
    body: "Practice doesn't make perfect. Perfect practice makes perfect. If you skip security checks in dev, you're doing yourself a disservice and increasing security exposure in prod. Practice security while you build, and you won't have to worry about security in production.",
  },
];
---

<BaseLayout
  title="About — Aaron Isaacs"
  description="Lead Backend Software Engineer at Koch Capabilities. Python, AWS, and distributed systems, with a working interest in concurrency and cloud architecture."
>
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">About</p>
      <h1>Who is Aaron?</h1>
    </header>

    <div class="prose intro">
      <p>
        I'm a Lead Backend Software Engineer and Technical Product Lead at Koch
        Capabilities, with roughly three and a half years of experience. My
        working stack is Python, AWS, and distributed systems. I also have a few
        years experience in C++, and I'm training on Go and Typescript.
      </p>
      <p>
        Born and raised in Kansas USA, I was encouraged to explore building
        things from a young age, including my very own PC when I was just 10
        years old. Ever since then, I've had a deep love for anything modular,
        anything I can tweak to improve, even just slightly. Whether that be my
        computer, code, or even my car. I enjoy rock climbing, spending time
        with friends, cooking, storytelling, and of course, building things.
      </p>
    </div>

    <section aria-labelledby="principles">
      <h2 id="principles">Principles</h2>
      <ul class="principles">
        {
          principles.map((principle) => (
            <li>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="background">
      <h2 id="background">Background</h2>
      <dl class="facts">
        <div>
          <dt>Current role</dt>
          <dd>
            Lead Backend Software Engineer / Technical Product Lead, Koch
            Capabilities, LLC
          </dd>
        </div>
        <div>
          <dt>Certification</dt>
          <dd>SnowPro Core (Snowflake) — June 2025</dd>
        </div>
        <div>
          <dt>Education</dt>
          <dd>
            B.S. Electrical Engineering, Minor in Computer Science — Wichita
            State University, June 2023. Magna Cum Laude, 3.65/4.0.
          </dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="contact">
      <h2 id="contact">Get in touch</h2>
      <p class="contact-lede">
        I'm open to Software Engineer, Backend, and Cloud/DevOps roles, hybrid
        or remote.
      </p>
      <ul class="chips">
        {
          contactLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-xl) var(--space-l);
    max-width: var(--measure);
  }

  .head h1 {
    margin-block-start: var(--space-xs);
  }

  .intro {
    font-size: var(--step-0);
  }

  section {
    margin-block-start: var(--space-2xl);
    max-width: var(--measure);
  }

  .principles {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-l);
    display: grid;
    gap: var(--space-l);
  }

  .principles h3 {
    color: var(--accent);
    font-size: var(--step-0);
  }

  .principles p {
    color: var(--text-muted);
    margin-block-start: var(--space-xs);
  }

  .facts {
    margin-block-start: var(--space-l);
    display: grid;
    gap: var(--space-m);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-dim);
  }

  .facts dd {
    margin: 0;
    margin-block-start: var(--space-2xs);
  }

  .contact-lede {
    color: var(--text-muted);
    margin-block: var(--space-m);
  }

  .chips a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: var(--space-xs) var(--space-m);
    text-decoration: none;
    display: inline-block;
  }

  .chips a:hover {
    border-color: var(--accent);
  }
</style>
