---
const links = [
  { href: "/", label: "Home" },
  { href: "/case-studies/", label: "Case Studies" },
  { href: "/about/", label: "About" },
];

// Normalise so "/about" and "/about/" both mark the same nav item current.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => (href.replace(/\/+$/, "") || "/") === path;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">aaron<span class="brand-accent">.isaacs</span></a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 1px solid var(--border);
    background-color: var(--bg);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-m);
  }

  .brand {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .brand-accent {
    color: var(--accent);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current="page"] {
    color: var(--accent);
  }
</style>
